{
  "name": "@presentation-maker/worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler types --check && tsc --noEmit && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "seed:admin": "node scripts/seed-admin.mjs"
  },
  "dependencies": { "hono": "^4.9.8" },
  "devDependencies": { "@cloudflare/workers-types": "latest", "typescript": "^5.9.2", "wrangler": "latest" }
}

